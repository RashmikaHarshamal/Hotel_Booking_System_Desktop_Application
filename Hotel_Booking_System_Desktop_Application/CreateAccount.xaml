<Window x:Class="Project.CreateAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Project"
        mc:Ignorable="d"
        Title="Create Account" Height="600" Width="900" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid>
        <!-- Background Image -->
        <Grid.Background>
            <ImageBrush ImageSource="D:\Hotel_Booking_System,\hotel-booking-system\public\image3.jpg"/>
        </Grid.Background>

        <!-- Semi-transparent create account panel -->
        <Border Background="#FFF0E0" CornerRadius="10" Padding="20" Width="500" Height="500"
                VerticalAlignment="Center" HorizontalAlignment="Center">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel VerticalAlignment="Center">
                    <!-- CREATE ACCOUNT Text at the Top -->
                    <TextBlock Text="CREATE ACCOUNT" FontSize="24" FontWeight="Bold" Foreground="Black"
                               HorizontalAlignment="Center" Margin="0,0,0,20"/>

                    <!-- Username -->
                    <TextBlock Text="Username:" Foreground="Black"/>
                    <Border Background="White" BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Padding="3">
                        <TextBox Name="txtUsername" Width="340" Height="30" FontSize="14" BorderThickness="0" Padding="5"/>
                    </Border>

                    <!-- Email -->
                    <TextBlock Text="Email:" Foreground="Black" Margin="0,10,0,0"/>
                    <Border Background="White" BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Padding="3">
                        <TextBox Name="txtEmail" Width="340" Height="30" FontSize="14" BorderThickness="0" Padding="5"/>
                    </Border>

                    <!-- Password -->
                    <TextBlock Text="Password:" Foreground="Black" Margin="0,10,0,0"/>
                    <Border Background="White" BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Padding="3">
                        <PasswordBox Name="txtPassword" Width="340" Height="30" FontSize="14" BorderThickness="0" Padding="5"/>
                    </Border>

                    <!-- Confirm Password -->
                    <TextBlock Text="Confirm Password:" Foreground="Black" Margin="0,10,0,0"/>
                    <Border Background="White" BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Padding="3">
                        <PasswordBox Name="txtConfirmPassword" Width="340" Height="30" FontSize="14" BorderThickness="0" Padding="5"/>
                    </Border>

                    <!-- Create Account Button at the Bottom -->
                    <Button Content="Create Account" Width="150" Height="35" Foreground="White" FontSize="14"
                            FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="0,20,0,10" Click="CreateAccount_Click"
                            HorizontalAlignment="Center">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#FF8C42"/>
                                <!-- Default Dark Orange Color -->
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FF7037"/>
                                        <!-- Darker Orange on Hover -->
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- "Already have an account? Login here" Link -->
                    <TextBlock HorizontalAlignment="Center" Margin="0,0,0,10" Cursor="Hand">
                        <Hyperlink Click="Login_Click" Foreground="#2e2018">
                            Already have an account? <Underline>Login here</Underline>
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>