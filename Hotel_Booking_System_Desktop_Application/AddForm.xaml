<Window x:Class="Project.Addform"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Project"
        mc:Ignorable="d"
        Title="Add Room" Height="600" Width="900" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Window.Resources>
        <!-- General Button Style -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Underline on Hover -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="TextBlock.TextDecorations" Value="Underline"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Logout Button Style with Rounded Corners -->
        <Style x:Key="LogoutButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#ff9900"/>
            <!-- Orange color -->
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="40"/>

            <!-- Template to create rounded corners -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <!-- Hover Effect -->
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#e68a00"/>
                    <!-- Darker orange for hover -->
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- Background Image -->
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="D:\Hotel_Booking_System,\hotel-booking-system\public\image3.jpg" Stretch="UniformToFill"/>
        </Grid.Background>

        <!-- Navigation Bar -->
        <DockPanel Background="#ff9900" Height="60" VerticalAlignment="Top">
            <!-- Logo and Title -->
            <TextBlock Text="LifeClinic" Foreground="White" FontSize="22" FontWeight="Bold" 
                       VerticalAlignment="Center" Margin="20,0,0,0"/>

            <!-- Navigation Buttons -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,20,0">
                <Button Content="Dashboard" Style="{StaticResource NavButtonStyle}" Click="homepage_Click"/>
                <Button Content="Available" Style="{StaticResource NavButtonStyle}" Click="available_Click"/>
                <Button Content="Add Form" Style="{StaticResource NavButtonStyle}" />

                <!-- Logout Button (Styled) -->
                <Button Content="Logout" Style="{StaticResource LogoutButtonStyle}" Click="Logout_Click"/>
            </StackPanel>
        </DockPanel>

        <!-- Content Area -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="200,100,200,20">
            <!-- Border around the form -->
            <Border Background="#FFF0E0" BorderBrush="#ff9900" BorderThickness="2" CornerRadius="10" Padding="20">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="400">
                    <!-- Form Title -->
                    <TextBlock Text="Add Room" FontSize="24" FontWeight="Bold" Foreground="Black"
                               HorizontalAlignment="Center" Margin="0,0,0,20"/>

                    <!-- Room Image Upload -->
                    <Border Background="white" BorderBrush="#ff9900" BorderThickness="1" CornerRadius="5" Padding="10">
                        <StackPanel>
                            <TextBlock Text="Upload Room Image" FontSize="14" Foreground="Black" Margin="0,0,0,10"/>
                            <Button Content="Choose Image" Width="120" Height="30" FontSize="14"
                                    Foreground="White" Background="#ff9900" BorderBrush="Gray" BorderThickness="1" Cursor="Hand"
                                    HorizontalAlignment="Left" Click="ChooseImage_Click"/>
                            <Image Name="RoomImagePreview" Width="100" Height="100" Margin="0,10,0,0"
                                   Stretch="UniformToFill" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <!-- Number of Beds -->
                    <TextBlock Text="Number of Beds:" FontSize="14" Foreground="Black" Margin="0,20,0,5"/>
                    <TextBox Name="txtNumberOfBeds" HorizontalAlignment="Stretch" Height="30" FontSize="14" Padding="5"/>

                    <!-- Price -->
                    <TextBlock Text="Price:" FontSize="14" Foreground="Black" Margin="0,20,0,5"/>
                    <TextBox Name="txtPrice" HorizontalAlignment="Stretch" Height="30" FontSize="14" Padding="5"/>

                    <!-- Type -->
                    <TextBlock Text="Type:" FontSize="14" Foreground="Black" Margin="0,20,0,5"/>
                    <TextBox Name="txtType" HorizontalAlignment="Stretch" Height="30" FontSize="14" Padding="5"/>

                    <!-- Submit Button -->
                    <Button Content="Submit" Width="120" Height="35" FontSize="14" Foreground="White"
                            Background="#ff9900" BorderThickness="0" Cursor="Hand" Margin="0,20,0,0"
                            HorizontalAlignment="Center" Click="Submit_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#ff9900"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#ff9900"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Window>