<Window x:Class="Project.AdminLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Project"
        mc:Ignorable="d"
        Title="Admin Login" Height="600" Width="900" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid>
        
        <Grid.Background>
            <ImageBrush ImageSource="D:\Hotel_Booking_System,\hotel-booking-system\public\image3.jpg" Stretch="UniformToFill"/>
        </Grid.Background>

       
        <Border Background="#FFF0E0" CornerRadius="10" Padding="20" Width="300" Height="300"
                VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel VerticalAlignment="Center">
               
                <TextBlock Text="Admin Login" FontSize="24" FontWeight="Bold" Foreground="Black"
                           HorizontalAlignment="Center" Margin="0,0,0,10"/>

                
                <TextBlock Text="Username:" Foreground="Black"/>
                <Border Background="White" BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Padding="3">
                    <TextBox Name="txtUsername" Width="240" Height="30" FontSize="14" BorderThickness="0" Padding="5"/>
                </Border>

                
                <TextBlock Text="Password:" Foreground="Black" Margin="0,10,0,0"/>
                <Border Background="White" BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Padding="3">
                    <PasswordBox Name="txtPassword" Width="240" Height="30" FontSize="14" BorderThickness="0" Padding="5"/>
                </Border>

                <!-- Login Button -->
                <Button Content="Login" Width="100" Height="35" Foreground="White" FontSize="14"
                        FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="0,20,0,0" Click="Login_Click"
                        HorizontalAlignment="Center">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#FF8C42"/>
                            <!-- Default Dark Orange Color -->
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FF7037"/>
                                    <!-- Darker Orange on Hover -->
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- User Login Link -->
                <TextBlock HorizontalAlignment="Center" Margin="0,6,0,0" Cursor="Hand">
                    <Hyperlink Click="UserLogin_Click" Foreground="#2e2018">
                        User Login? <Underline>Login Here</Underline>
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</Window>